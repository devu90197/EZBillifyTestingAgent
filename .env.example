# Copy to .env and fill in. NEVER commit real secrets (.env is git-ignored).

# ── Platform ─────────────────────────────────────────────────────────────
EZT_ENV=local
# read-only is the safe default against production targets
EZT_SAFETY_MODE=read-only
EZT_ARTIFACT_DIR=./artifacts

# Optional: override the web runner target. Normally comes from the product config.
# EZT_TARGET_URL=https://ezbillify.com

# ── EzBillify dedicated QA test account (NEVER a real customer) ───────────
EZT_EZBILLIFY_TEST_EMAIL=
EZT_EZBILLIFY_TEST_PASSWORD=

# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for client auth flows)
SUPABASE_ANON_KEY=
# ⚠️ SERVICE ROLE bypasses Row-Level Security — leave BLANK for prod.
# Only set it if pointing at a dedicated STAGING/TEST Supabase project.
SUPABASE_SERVICE_ROLE_KEY=
# READ-ONLY Postgres connection string for DB validation (use a read-only role):
# postgresql://readonly_user:PASSWORD@HOST:6543/postgres
SUPABASE_DB_URL=
# For the `supabase` CLI (schema introspection / migrations), optional:
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ── Mobile (Appium) ──────────────────────────────────────────────────────
# Keep the driver home OUTSIDE the pnpm workspace, or Appium's installer trips
# over the `workspace:` protocol. Default user home works.
APPIUM_HOME=C:/Users/devu1/.appium
