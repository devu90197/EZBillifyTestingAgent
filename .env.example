# Copy to .env and adjust. Never commit real secrets.
EZT_ENV=local
# read-only is the safe default against production targets
EZT_SAFETY_MODE=read-only
EZT_ARTIFACT_DIR=./artifacts

# Optional: override the web runner target. Normally comes from the product config.
# EZT_TARGET_URL=https://example.com

# Mobile (Appium): keep the driver home OUTSIDE the pnpm workspace, or Appium's
# driver installer trips over the `workspace:` protocol. Default user home works.
APPIUM_HOME=C:/Users/devu1/.appium
